  "patterns": [
    {
      "match": "^Thought for (.+)$",
      "replace": "思考了 $1"
    },
    {
      "match": "^Running… \\((.+?) to cancel\\)$",
      "replace": "运行中…（按 $1 取消）"
    },
    {
      "match": "^… (\\d+) more lines \\((.+?) to expand\\)$",
      "replace": "… 还有 $1 行（按 $2 展开）"
    },
    {
      "match": "^\\(exit (\\d+)\\)$",
      "replace": "（退出码 $1）"
    },
    {
      "match": "^(\\d+) diagnostics?$",
      "replace": "$1 个诊断"
    },
    {
      "match": "^(\\d+) matches?$",
      "replace": "$1 个匹配"
    },
    {
      "match": "^Retrying · attempt (\\d+) of (\\d+)$",
      "replace": "重试中 · 第 $1 / $2 次"
    },
    {
      "match": "^Retrying \\((\\d+)/(\\d+)\\) in (.+?)…(.*)$",
      "replace": "重试中（$1/$2），剩余 $3…$4"
    },
    {
      "match": "^Auto-compacting context(\\.\\.\\.|…)(.*)$",
      "replace": "正在自动压缩上下文…$2"
    },
    {
      "match": "^Compacting context(\\.\\.\\.|…)(.*)$",
      "replace": "正在压缩上下文…$2"
    },
    {
      "match": "^Generating handoff…(.*)$",
      "replace": "正在生成交接文档…$1"
    },
    {
      "match": "^Approve and keep context \\(~(.+) / (.+)\\)$",
      "replace": "批准并保留上下文（~$1 / $2）"
    },
    {
      "match": "^Approve (.+) for this session$",
      "replace": "本会话允许 $1"
    },
    {
      "match": "^Approve this call(.*)$",
      "replace": "批准本次调用$1"
    },
    {
      "match": "^Deny this call(.*)$",
      "replace": "拒绝本次调用$1"
    },
    {
      "match": "^Show every detail of this call(.*)$",
      "replace": "展开本次调用详情$1"
    },
    {
      "match": "^Summarize this call(.*)$",
      "replace": "折叠本次调用详情$1"
    },
    {
      "match": "^Copy plan(.*)$",
      "replace": "复制计划$1"
    },
    {
      "match": "^(.+) tokens$",
      "replace": "$1 个 token"
    },
    {
      "match": "Running requested (.+) command",
      "replace": "正在执行请求的 $1 命令"
    },
    {
      "match": "… (\\d+) earlier lines, showing (\\d+) of (\\d+)",
      "replace": "… 前 $1 行，显示 $2/$3"
    },
    {
      "match": "Output(?=(?:\\s|\\x1b\\[[0-9;]*m)*─)",
      "replace": "输出"
    },
    {
      "match": "Wall: (\\d+(?:\\.\\d+)?s)",
      "replace": "耗时: $1"
    },
    {
      "match": "Timeout: (\\d+)s",
      "replace": "超时: $1s"
    },
    {
      "match": "elapsed (\\d+(?:\\.\\d+)?s)",
      "replace": "耗时 $1"
    }
  ],
